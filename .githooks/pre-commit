#!/usr/bin/env bash
# Leak-gate: block any commit whose staged file CONTENTS contain identifying tokens.
# Content-based (not diff-based), correct exit codes. Constitution principle I.
set -euo pipefail
patterns='(\b[0-9]{1,3}(\.[0-9]{1,3}){3}\b)|(\bWIN-[A-Z0-9]{6,}\b)|(\bS-1-([0-9]+-)+[0-9]+\b)|((Data Source|Initial Catalog|User ID|Password)=)'
leak=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in .githooks/pre-commit) continue;; esac
  if grep -qEI "$patterns" "$f" 2>/dev/null; then
    echo "leak-gate: identifying token in staged file: $f" >&2
    leak=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)
if [ "$leak" != 0 ]; then
  echo "COMMIT BLOCKED: remove host/IP/SID/connection-string tokens (constitution I)." >&2
  exit 1
fi
