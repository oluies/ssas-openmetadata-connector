# Tabular SSAS ingestion (milestone-1 DoD). Committed as a TEMPLATE — no secrets.
# The run script substitutes ${...} from .env into a gitignored runtime copy.
source:
  type: customDatabase
  serviceName: ssas_tabular
  serviceConnection:
    config:
      type: CustomDatabase
      sourcePythonClass: ssas_om.source.SsasSource
      connectionOptions:
        host: "${SSAS_HOST}"
        endpoint: "/olap-tab/msmdpump.dll"
        user: "${SSAS_USER}"
        password: "${SSAS_PASSWORD}"
        catalog: "AWTabular"
        # table-level lineage to the SQL source ingested by ingestion-mssql.yaml
        lineageService: "hetzner_mssql"
        lineageDatabase: "AdventureWorksDW2022"
        lineageSchema: "dbo"
        # sample data: a few example rows per tabular table (DAX EVALUATE TOPN).
        # On by default; set includeSampleData: "false" to disable, or lower the cap.
        includeSampleData: "true"
        sampleDataRowCount: "50"
  sourceConfig:
    config:
      type: DatabaseMetadata
sink:
  type: metadata-rest
  config: {}
workflowConfig:
  openMetadataServerConfig:
    hostPort: "http://openmetadata-server:8585/api"
    authProvider: openmetadata
    securityConfig:
      jwtToken: "${OM_JWT_TOKEN}"
