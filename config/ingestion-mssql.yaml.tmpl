# MSSQL engine ingestion (T014) — the lineage target (AdventureWorksDW2022).
# Built-in OpenMetadata MSSQL connector via pymssql (pure-Python, no ODBC driver).
# Committed as a TEMPLATE — no secrets; run script substitutes from .env.
source:
  type: mssql
  serviceName: hetzner_mssql
  serviceConnection:
    config:
      type: Mssql
      # SQL-auth default (pure-Python, no ODBC driver):
      scheme: mssql+pymssql
      username: "${MSSQL_USER}"
      password: "${MSSQL_PASSWORD}"
      hostPort: "${MSSQL_HOST}:1433"
      database: "AdventureWorksDW2022"
      # --- Windows / Kerberos integrated auth (OM built-in, no extra install) ---
      # python-tds (pytds) ships in the ingestion image with KerberosAuth/SspiAuth/
      # NtlmAuth/SpnegoAuth. To use it: switch the scheme to mssql+pytds, provide a
      # krb5.conf + ticket/keytab (kinit) in the runtime, and set the SQL SPN:
      #   scheme: mssql+pytds
      #   connectionArguments:
      #     use_sspi: true            # Windows integrated auth via pytds
      #   # username/password may be omitted when a Kerberos ticket is present.
  sourceConfig:
    config:
      type: DatabaseMetadata
      includeTables: true
      includeViews: true
      schemaFilterPattern:
        includes: ["dbo"]

# Relational-side sample data & column profiling is a SEPARATE OpenMetadata
# "profiler" workflow (type: profiler) over the same service — it samples real
# rows from SQL Server. To run it, use a profiler workflow and toggle sampling
# with generateSampleData (default true) / disable it per table:
#   source:
#     sourceConfig:
#       config:
#         type: Profiler
#         generateSampleData: true      # set false to skip sample rows
#         profileSample: 50             # percent or row count of the sample
#   processor:
#     type: orm-profiler
#     config: {}
sink:
  type: metadata-rest
  config: {}
workflowConfig:
  openMetadataServerConfig:
    hostPort: "http://openmetadata-server:8585/api"
    authProvider: openmetadata
    securityConfig:
      jwtToken: "${OM_JWT_TOKEN}"
